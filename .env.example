# Copia este archivo como `.env` y completa los valores reales.
# `.env` está en .gitignore: no se sube al repositorio ni al CMS.
#
# Nuxt asigna automáticamente cada NUXT_<NOMBRE> a la clave camelCase
# equivalente de runtimeConfig (NUXT_COMET_API_TOKEN -> cometApiToken).

# URL base del sitio Comet CMS (sin /api/v1 y sin barra final)
NUXT_COMET_URL=https://cms-una.gt.tc

# Slug del workspace dentro de Comet CMS (minúsculas, guiones)
NUXT_COMET_WORKSPACE=premios-nobel

# Token usado por el SERVICIO NUXT para leer el contenido.
# En CometCMS v1.0.1 la lectura pública NO necesita token, así que puede quedar
# vacío. Sólo es necesario si los content types se marcan como "Private"
# (opción disponible a partir de v1.0.2).
# Sólo se envía si el valor empieza con "ctcms_".
NUXT_COMET_API_TOKEN=

# Token con permisos de escritura, usado SOLO por el script de importación
# (`npm run cms:import`): content.read + content.create + content.update +
# content.publish. No se necesita en Netlify.
COMET_IMPORT_TOKEN=
